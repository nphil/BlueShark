{
  "domain": "blueshark",
  "name": "BlueShark Integration",
  "version": "0.9.2",
  "documentation": "https://github.com/nphil/BlueShark",
  "issue_tracker": "https://github.com/nphil/BlueShark/issues",
  "codeowners": ["@nphil"],
  "config_flow": true,
  "dependencies": ["bluetooth", "http", "frontend", "websocket_api"],
  "bluetooth": [
    { "connectable": true, "service_uuid": "0000fff0-0000-1000-8000-00805f9b34fb" },
    { "connectable": true, "local_name": "iLedClock*" },
    { "connectable": true, "local_name": "CoolLED*" }
  ],
  "integration_type": "device",
  "iot_class": "local_push",
  "requirements": ["bleak-retry-connector>=3.8.0"]
}
